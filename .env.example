# Application Port
PORT=3000

# PostgreSQL Database Configuration
# Specify your server credentials and database name here.
# On application start, it will automatically connect, create the database, and create all tables if they do not exist.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=colcom_biosecurity_db

# Alternatively, specify a single connection URI:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/colcom_biosecurity_db

# Corporate Email Alerts (Triple C SOC)
SMTP_HOST=smtp.triplecpigs.co.zw
SMTP_PORT=587
SMTP_USER=soc@triplecpigs.co.zw
SMTP_PASS=your_email_password
EMAIL_FROM=no-reply.soc@triplecpigs.co.zw

# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

